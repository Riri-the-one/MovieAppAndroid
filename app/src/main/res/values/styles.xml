<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="RoundedPoster">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="RoundedPosterLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="RoundedPosterTop">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">18dp</item>
        <item name="cornerSizeTopRight">18dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ShapeAppearance.Movies.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.Movies.AvatarCircle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="TextAppearance.Movies.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/md_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Movies.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/md_on_surface_variant</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="TextAppearance.Movies.Synopsis" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/md_on_surface_variant</item>
        <item name="android:lineSpacingExtra">6dp</item>
    </style>

</resources>
